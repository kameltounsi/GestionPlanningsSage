# Template .env pour une VM Linux.
# Copier en `.env`, remplacer les valeurs CHANGE_ME, puis lancer:
# docker compose up -d --build

COMPOSE_PROJECT_NAME=gestionplanning

# Base PostgreSQL persistante dans le volume Docker `planning-data`.
POSTGRES_DB=plannings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Sur une VM exposee au reseau, eviter d'exposer PostgreSQL publiquement.
# Laisser 127.0.0.1:5432 pour les sauvegardes locales sur la VM.
POSTGRES_HOST_PORT=127.0.0.1:5432

# Ports applicatifs exposes par la VM.
SERVER_PORT=3001
APP_FRONTEND_URL=http://VM_IP_OR_DOMAIN:3000
VITE_API_BASE_URL=/api

# Stockage des fichiers. Obligatoire car docker-compose.yml refuse les valeurs vides.
CLOUDINARY_CLOUD_NAME=CHANGE_ME_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=CHANGE_ME_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=CHANGE_ME_CLOUDINARY_API_SECRET

# SMTP. Desactiver temporairement les envois si la VM n'a pas encore acces au SMTP.
SPRING_MAIL_HOST=ssl0.ovh.net
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
SPRING_MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=false
SPRING_MAIL_STARTTLS_REQUIRED=false
SPRING_MAIL_SSL_ENABLE=true

APP_ACCOUNT_MAIL_ENABLED=true
APP_ALERT_MAIL_ENABLED=true
APP_WEEKLY_PROGRESS_MAIL_ENABLED=true
APP_WEEKLY_PROGRESS_MAIL_CRON=0 0 8 * * MON
APP_WEEKLY_PROGRESS_MAIL_ZONE=Africa/Tunis

# Services optionnels.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

SONARQUBE_PORT=9000
SONAR_POSTGRES_DB=sonarqube
SONAR_POSTGRES_USER=sonarqube
SONAR_POSTGRES_PASSWORD=CHANGE_ME_SONAR_DB_PASSWORD
